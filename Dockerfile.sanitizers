# The Linux toolchain for the sanitizer builds (make asan / ubsan / tsan,
# make sanitize-test, make tsan-test) and for clang-tidy / clang-format
# (make lint, make lint-all, make format-diffstat). scripts/sanitize.py and
# scripts/lint.py build this image on first use (tagged with a checksum of
# this file, so an edit here builds a new one) and run it with the project
# directory mounted at /work; nothing from the source tree is copied in.
#
# Same pinned base as the other toolchain images. Ubuntu 24.04 ships LLVM 18.1.3 as
# clang-18; the server is compiled against libc++ (as on macOS and in the
# guest), not libstdc++. openssl mints the replay tests' throwaway CAs.
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

RUN apt-get update && apt-get install -y --no-install-recommends \
    bzip2 ca-certificates clang-18 clang-format-18 clang-tidy-18 curl \
    libc++-18-dev libc++abi-18-dev libclang-rt-18-dev llvm-18 make openssl perl \
    python3 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/llvm-symbolizer-18 /usr/local/bin/llvm-symbolizer

WORKDIR /work
