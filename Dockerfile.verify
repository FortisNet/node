# Reproducible tool families for make verify; build/test tooling only.
FROM node:25.9.0-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS node-tools
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
RUN apt-get update && apt-get install -y --no-install-recommends \
    bzip2 ca-certificates clang-18 clang-format-18 clang-tidy-18 cppcheck curl \
    gcc-13 g++-13 git libc++-18-dev libc++abi-18-dev make openssl \
    python3 shellcheck doxygen \
    && rm -rf /var/lib/apt/lists/*
# Unicode tables currently record Node 25 / Unicode 17. Use the matching,
# digest-pinned tool instead of Ubuntu's Node 18 / Unicode 15.1.
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
WORKDIR /work
